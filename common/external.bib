  author = {Kim, Seung Soo and Yong, Soo Kyeom and Kim, Whayoung and Kang, Sukin and Park, Hyeon Woo and Yoon, Kyung Jean and Sheen, Dong Sun and Lee, Seho and Hwang, Cheol Seong},
  year = 2023,
