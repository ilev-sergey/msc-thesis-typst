@article{gubernaGiantElectromechanicalEffect2024,
  title = {Giant {{Electromechanical Effect}} in {{Piezoelectric Nanomembranes Based}} on {{Hf}} {\textsubscript{0.5}} {{Zr}} {\textsubscript{0.5}} {{O}} {\textsubscript{2}}},
  author = {Guberna, Elizaveta and Margolin, Ilya and Kalika, Elizaveta and Zarubin, Sergei and Zhuk, Maksim and Chouprik, Anastasia},
  year = 2024,
  month = jan,
  journal = {ACS Applied Materials \& Interfaces},
  volume = {16},
  number = {1},
  pages = {975--984},
  issn = {1944-8244, 1944-8252},
  doi = {10.1021/acsami.3c11141},
  urldate = {2024-01-17},
  abstract = {Since ultrathin ferroelectric HfO2 films can be conformally grown by atomic layer deposition even on complex three-dimensional structures, new horizons in the development of next-generation piezoelectric devices are opened. However, hafnium oxide has a significant drawback for piezoelectric applications: its piezoelectric coefficients are much smaller than those of classical materials currently used in piezoelectric devices. Therefore, new approaches to the development of high-performance piezoelectric devices based on exploiting the unique properties of HfO2 are of paramount importance. In this work, a giant electromechanical effect in miniature piezoelectric membrane devices based on a 10 nm-thick ferroelectric Hf0.5Zr0.5O2 (HZO) film is experimentally demonstrated. Compared to the pure piezoelectric effect in the HZO film, the gain of the electromechanical response in membrane devices reaches 25 times. Numerical simulations confirm that this effect stems from the asymmetric shape of the membranes and can be further improved by designing the device geometry. Furthermore, according to first-principles calculations, an additional opportunity to improve the piezoelectric coefficient, and hence, the device efficiency is provided by the engineering of the mechanical stress in the HZO film. The proposed approach enables the development of new promising piezoelectric devices including miniature reflectors, nanoactuators, and nanoswitches.},
  langid = {english},
  keywords = {harvesting,ours},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\guberna\Guberna et al. - 2024 - Giant Electromechanical Effect in Piezoelectric Nanomembranes Based on Hf 0.5 Zr 0.5.pdf}
}

