  booktitle = {2023 {{International Electron Devices Meeting}} ({{IEDM}})},
  author = {Ramaswamy, N. and Calderoni, A. and Zahurak, J. and Servalli, G. and Chavan, A. and Chhajed, S. and Balakrishnan, M. and Fischer, M. and Hollander, M. and Ettisserry, D. P. and Liao, A. and Karda, K. and Jerry, M. and Mariani, M. and Visconti, A. and Cook, B. R. and Cook, B. D. and Mills, D. and Torsi, A. and Mouli, C. and Byers, E. and Helm, M. and Pawlowski, S. and Shiratake, S. and Chandrasekaran, N.},
