@article{aliRecentProgressEnergyRelated2020,
  title = {Recent {{Progress}} on {{Energy-Related Applications}} of {{HfO}}{\textsubscript{2}} -{{Based Ferroelectric}} and {{Antiferroelectric Materials}}},
