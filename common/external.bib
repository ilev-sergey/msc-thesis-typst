  file = {C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\Hang-Ting Lue\\Hang-Ting Lue et al. - 2002 - Device modeling of ferroelectric memory field-effect transistor (FeMFET).pdf;C\:\\Users\\Sergey\\Zotero\\storage\\4BR479UJ\\1036089.html}
}

@article{luElectricallyInducedCancellation2024,
  title = {Electrically Induced Cancellation and Inversion of Piezoelectricity in Ferroelectric {{Hf0}}.{{5Zr0}}.{{5O2}}},
  author = {Lu, Haidong and Kim, Dong-Jik and Aramberri, Hugo and Holzer, Marco and Buragohain, Pratyush and Dutta, Sangita and Schroeder, Uwe and Deshpande, Veeresh and {\'I}{\~n}iguez, Jorge and Gruverman, Alexei and Dubourdieu, Catherine},
  year = 2024,
  month = jan,
  journal = {Nature Communications},
  volume = {15},
  number = {1},
  pages = {860},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-44690-9},
  urldate = {2024-12-02},
  abstract = {Abstract                            HfO               2               -based thin films hold huge promise for integrated devices as they show full compatibility with semiconductor technologies and robust ferroelectric properties at nanometer scale. While their polarization switching behavior has been widely investigated, their electromechanical response received much less attention so far. Here, we demonstrate that piezoelectricity in Hf               0.5               Zr               0.5               O               2               ferroelectric capacitors is not an invariable property but, in fact, can be intrinsically changed by electrical field cycling. Hf               0.5               Zr               0.5               O               2               capacitors subjected to ac cycling undergo a continuous transition from a positive effective piezoelectric coefficient               d               33               in the pristine state to a fully inverted negative               d               33               state, while, in parallel, the polarization monotonically increases. Not only can the sign of               d               33               be uniformly inverted in the whole capacitor volume, but also, with proper ac training, the net effective piezoresponse can be nullified while the polarization is kept fully switchable. Moreover, the local piezoresponse force microscopy signal also gradually goes through the zero value upon ac cycling. Density functional theory calculations suggest that the observed behavior is a result of a structural transformation from a weakly-developed polar orthorhombic phase towards a well-developed polar~orthorhombic phase. The calculations also suggest the possible occurrence of a non-piezoelectric ferroelectric Hf               0.5               Zr               0.5               O               2               . Our experimental findings create an unprecedented potential for tuning the electromechanical functionality of ferroelectric HfO               2               -based devices.},
  langid = {english},
  file = {C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\LU\\Lu et al. - 2024 - Electrically induced cancellation and inversion of piezoelectricity in ferroelectric Hf0.5Zr0.5O2.docx;C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\LU\\Lu et al. - 2024 - Electrically induced cancellation and inversion of piezoelectricity in ferroelectric Hf0.5Zr0.5O2.pdf}
}

@article{luoHighprecisionLinearWeight2022,
  title = {High-Precision and Linear Weight Updates by Subnanosecond Pulses in Ferroelectric Tunnel Junction for Neuro-Inspired Computing},
  author = {Luo, Zhen and Wang, Zijian and Guan, Zeyu and Ma, Chao and Zhao, Letian and Liu, Chuanchuan and Sun, Haoyang and Wang, He and Lin, Yue and Jin, Xi and Yin, Yuewei and Li, Xiaoguang},
  year = 2022,
  month = feb,
  journal = {Nature Communications},
  volume = {13},
  number = {1},
  pages = {699},
  issn = {2041-1723},
  doi = {10.1038/s41467-022-28303-x},
  urldate = {2024-09-19},
  abstract = {Abstract                            The rapid development of neuro-inspired computing demands synaptic devices with ultrafast speed, low power consumption, and multiple non-volatile states, among other features. Here, a high-performance synaptic device is designed and established based on a Ag/PbZr               0.52               Ti               0.48               O               3               (PZT, (111)-oriented)/Nb:SrTiO               3               ferroelectric tunnel junction (FTJ). The advantages of (111)-oriented PZT (\textasciitilde 1.2\,nm) include its multiple ferroelectric switching dynamics, ultrafine ferroelectric domains, and small coercive voltage. The FTJ shows high-precision (256 states, 8 bits), reproducible (cycle-to-cycle variation, \textasciitilde 2.06\%), linear (nonlinearity {$<$}1) and symmetric weight updates, with a good endurance of {$>$}10               9               cycles and an ultralow write energy consumption. In particular, manipulations among 150 states are realized under subnanosecond (\textasciitilde 630\,ps) pulse voltages {$\leq$}5\,V, and the fastest resistance switching at 300\,ps for the FTJs is achieved by voltages {$<$}13\,V. Based on the experimental performance, the convolutional neural network simulation achieves a high online learning accuracy of \textasciitilde 94.7\% for recognizing fashion product images, close to the calculated result of \textasciitilde 95.6\% by floating-point-based convolutional neural network software. Interestingly, the FTJ-based neural network is very robust to input image noise, showing potential for practical applications. This work represents an important improvement in FTJs towards building neuro-inspired computing systems.},
  langid = {english},
  file = {C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\luo\\Luo et al. - 2022 - High-precision and linear weight updates by subnanosecond pulses in ferroelectric tunnel junction fo_1.pdf;C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\luo\\Luo et al. - 2022 - High-precision and linear weight updates by subnanosecond pulses in ferroelectric tunnel junction fo.pdf}
}

@article{luoThicknessDependenceFerroelectricity2025,
  title = {Thickness Dependence of Ferroelectricity in {{HfO}}{\textsubscript{2}}-Based Thin Film Due to the Grain Size Effect},
  author = {Luo, Jie and Wang, Junhui and Huang, Xinran and Mu, Xinpeng and Duan, Tianpeng and Jiang, Limei and Zhou, Yichun and Yang, Qiong and Liao, Jiajia and Jiang, Jie},
  year = 2025,
  month = nov,
  journal = {Nano Research},
  volume = {18},
  number = {11},
  pages = {94907687},
  publisher = {清华大学出版社},
  issn = {1998-0124},
  doi = {10.26599/NR.2025.94907687},
  urldate = {2026-04-16},
  abstract = {{$<$}p{$>$}Compared to traditional perovskite ferroelectric materials, HfO\textsubscript{2} has emerged as a prominent research focus due to its ability to retain significant ferroelectricity at the nanoscale. However, systematic studies on its performance in thicker films remain limited, leaving the intrinsic relationship between thickness variation and ferroelectric properties poorly understood. In this work, we successfully fabricated doped HfO\textsubscript{2}-based ferroelectric thin films with thicknesses spanning tens to hundreds of nanometers. All these films exhibit robust ferroelectric characteristics, and their ferroelectric properties demonstrate a non-monotonic evolution with increasing thickness. Macroscopic electrical measurements and mesoscale domain switching analysis confirmed that the ferroelectric properties of Ce:HfO\textsubscript{2} films first diminish and then recover with the increase of film thickness. By further characterizing the evolution of microscopic structures, we elucidate the thickness effects on the grain size distribution and domain structure evolution. This framework clarifies the physical mechanism underlying the thickness-dependent ferroelectric behavior. Our findings provide critical experimental evidence for developing large-scale HfO\textsubscript{2}-based ferroelectric devices and lay a theoretical foundation for optimizing thick-film ferroelectric materials for practical applications.{$<$}/p{$>$}},
  langid = {english},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\Luo\Luo et al. - 2025 - Thickness dependence of ferroelectricity in HfO2-based thin film due to the grain size ef.pdf}
}

@article{luProbingAntiferroelectricFerroelectricPhase2020,
  title = {Probing {{Antiferroelectric}}-{{Ferroelectric Phase Transitions}} in {{PbZrO}} {\textsubscript{3}} {{Capacitors}} by {{Piezoresponse Force Microscopy}}},
  author = {Lu, Haidong and Glinsek, Sebastjan and Buragohain, Pratyush and Defay, Emmanuel and I{\~n}iguez, Jorge and Gruverman, Alexei},
  year = 2020,
  month = nov,
  journal = {Advanced Functional Materials},
  volume = {30},
  number = {45},
  pages = {2003622},
  issn = {1616-301X, 1616-3028},
  doi = {10.1002/adfm.202003622},
  urldate = {2023-11-17},
  abstract = {Abstract                            Functional characterization of antiferroelectric (AFE) materials typically involves macroscopic testing of their nonlocal integrated information on their dielectric properties, such as polarization hysteresis loops, field-dependent strain, and capacitance while the local AFE properties have been rarely addressed. Here, a new protocol is demonstrated for local probing of the antiferroelectric/ferroelectric (AFE/FE) phase transition in PbZrO               3               capacitors by piezoresponse force microscopy (PFM). PFM spectroscopy of the local AFE/FE phase transition parameters is performed and their spatial variability via two-dimensional mapping is investigated. It is shown that AFE hysteresis loops recorded by PFM in the bias-on regime exhibit four characteristic amplitude peaks. Within the framework of Landau theory, these features are attributed to a considerable increase in the electromechanical strain response due to the dielectric constant divergence during AFE/FE phase transitions. The proposed approach can be used to differentiate between the antiferroelectric and nonpolar dielectric phases in functional devices using the electrically induced polarization.},
  langid = {english},
  keywords = {antiferroelectrics,FE/AFE transition,Landau theory,PFM,PFM spectroscopy},
  file = {C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\lu\\Lu et al. - 2020 - Probing Antiferroelectric‐Ferroelectric Phase Transitions in PbZrO 3 Capacitors by Piezor 2.pdf;C\:\\Users\\Sergey\\OneDrive\\zotero-library\\AUTH\\lu\\Lu et al. - 2020 - Probing Antiferroelectric‐Ferroelectric Phase Transitions in PbZrO 3 Capacitors by Piezor.pdf}
}

@misc{magagninNovelElectricalCharacterization2025,
  title = {Novel {{Electrical Characterization Method}} for {{Antiferroelectrics}} Using a {{Positive Up Negative Down Approach}}},
  author = {Magagnin, Gr{\'e}goire and Berre, Martine Le and Gonzalez, Sara and Deleruyelle, Damien and Vilquin, Bertrand and Bouaziz, Jordan},
  year = 2025,
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2501.05358},
  urldate = {2025-08-03},
  abstract = {This study demonstrates the effectiveness of AFE-PUND, a revisited Positive Up Negative Down (PUND) protocol for characterizing antiferroelectric (AFE) materials, in analyzing ZrO2 films across different thicknesses, revealing key trends. The proposed AFE-PUND method enables the isolation of switching currents from non-switching contributions, allowing precise extraction of remanent polarization and coercive field from hysteresis loops. The remanent polarization increases with film thickness, reflecting enhanced domain stability, while endurance cycles highlight the wakeup effect and its eventual degradation due to fatigue in thicker films. Similarly, coercive fields decrease with thickness, indicating reduced switching barriers and a clearer transition between tetragonal and orthorhombic phases. The method provides valuable insights into micro-structural influences, such as defect accumulation, grain size, and domain wall pinning, which critically affect device performance. AFE-PUND thus establishes itself as an essential tool for advancing the understanding and optimization of antiferroelectric materials.},
  copyright = {Creative Commons Attribution 4.0 International},
  langid = {english},
  keywords = {short list},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\Magagnin\Magagnin et al. - 2025 - Novel Electrical Characterization Method for Antiferroelectrics using a Positive Up Negative Down Ap.pdf}
}

