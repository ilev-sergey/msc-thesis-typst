@article{parkRevivalFerroelectricMemories2023,
  title = {Revival of {{Ferroelectric Memories Based}} on {{Emerging Fluorite}}-{{Structured Ferroelectrics}}},
  author = {Park, Ju Yong and Choe, Duk-Hyun and Lee, Dong Hyun and Yu, Geun Taek and Yang, Kun and Kim, Se Hyun and Park, Geun Hyeong and Nam, Seung-Geol and Lee, Hyun Jae and Jo, Sanghyun and Kuh, Bong Jin and Ha, Daewon and Kim, Yongsung and Heo, Jinseong and Park, Min Hyuk},
  year = 2023,
