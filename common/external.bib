@article{ledererOriginWakeUpAntiferroelectricLike2021,
  title = {On the {{Origin}} of {{Wake-Up}} and {{Antiferroelectric-Like Behavior}} in {{Ferroelectric Hafnium Oxide}}},
  author = {Lederer, Maximilian and Olivo, Ricardo and Lehninger, David and Abdulazhanov, Sukhrob and K{\"a}mpfe, Thomas and Kirbach, Sven and Mart, Clemens and Seidel, Konrad and Eng, Lukas M.},
