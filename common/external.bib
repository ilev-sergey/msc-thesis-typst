}

@article{muellerReliabilityCharacteristicsFerroelectric2013,
  title = {Reliability {{Characteristics}} of {{Ferroelectric}} \$ \textbackslash hbox\textbraceleft{{Si}}:{{HfO}}\textbraceright\_\textbraceleft 2\textbraceright\$ {{Thin Films}} for {{Memory Applications}}},
  shorttitle = {Reliability {{Characteristics}} of {{Ferroelectric}}},
  author = {Mueller, Stefan and Muller, Johannes and Schroeder, Uwe and Mikolajick, Thomas},
  year = 2013,
  month = mar,
  journal = {IEEE Transactions on Device and Materials Reliability},
  volume = {13},
  number = {1},
  pages = {93--97},
  issn = {1530-4388, 1558-2574},
  doi = {10.1109/TDMR.2012.2216269},
  urldate = {2023-11-17},
  abstract = {Reliability characteristics of ferroelectric thin films (10 nm) based on Si-doped HfO2 have been investigated with focus on potential memory applications. Extensive retention, imprint, and endurance data for this new type of ferroelectric material are presented for the first time. The variability of reliability characteristics in terms of capacitor annealing temperatures as well as excitation amplitude effects is analyzed. Stable ferroelectric switching behavior can be observed in a wide temperature range from 80 K up to 470 K. Bake tests at 125 \textopenbullet C show almost no retention loss for saturated polarization states up to cumulative testing times of 1000 h. In addition to the same-state retention, opposite-state retention was observed to be equally stable. Traditional imprint behavior of the programmed state occurs after a few hours of baking time, and stable behavior could be verified until the end of the 1000-h retention test. Endurance characteristics of the ferroelectric thin films are shown to depend significantly on the annealing temperature of the capacitors and on the cycling voltage during testing. In thin films which had been annealed at 1000 \textopenbullet C, breakdown at 2 MV/cm limits endurance after 108 cycles. A lower annealing temperature of 650 \textopenbullet C could improve the breakdown-limited endurance to 1010 cycles.},
  langid = {english},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\Mueller\Mueller et al. - 2013 - Reliability Characteristics of Ferroelectric $ hbox SiHfO _ 2 $ Thin Films for Memory Applications.pdf}
}

