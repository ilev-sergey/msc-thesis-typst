  issn = {2196-7350, 2196-7350},
  doi = {10.1002/admi.202600003},
  urldate = {2026-06-08},
  abstract = {The discovery of ferroelectricity in HfO2 offering the advantage of nonvolatile polarization switching creates a renewed interest in the semiconductor memory industry. Doped HfO2-based thin films maintain stable remanent polarization (Pr) at nanometer-scale thicknesses within back-end-of-line thermal budgets, which makes them an attractive material family for compact ferroelectric capacitors (FeCAPs) and ferroelectric field-effect transistors (FeFETs) in embedded and in-memory computing. The orientation of electric dipoles in the HfO2 layer defines the stored information in FeCAPs and adjusts the electron density in the channel of FeFETs. Therefore, controlling dipole rotation, which is closely linked to Pr, plays an important role in achieving reliable memory operation. In this review, we first show the evolution of doped HfO2 thin films in terms of engineering the ferroelectric orthorhombic phase. Since the ferroelectric HfO2 layer is deposited onto non-inert metal electrodes in FeCAPs or semiconductor materials serving as a channel in FeFETs, the reliability characteristics of the ferroelectric memories primarily depend on these interface conditions. Therefore, we second address recent interface engineering strategies tailored to each device configuration.},
  langid = {english},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\Kim\Kim and Woo - 2026 - Evolution of Materials and Device Stacks for HfO2 ‐Based Ferroelectric Memories.pdf}
}

