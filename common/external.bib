@article{kondratyukPolarizationSwitchingKinetics2022,
  title = {Polarization {{Switching Kinetics}} in {{Thin Ferroelectric HZO Films}}},
  author = {Kondratyuk, Ekaterina and Chouprik, Anastasia},
  year = 2022,
