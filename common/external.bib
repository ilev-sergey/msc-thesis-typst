@article{muellerIncipientFerroelectricityAlDoped2012,
  title = {Incipient {{Ferroelectricity}} in {{Al}}-{{Doped HfO}} {\textsubscript{2}} {{Thin Films}}},
  author = {Mueller, Stefan and Mueller, Johannes and Singh, Aarti and Riedel, Stefan and Sundqvist, Jonas and Schroeder, Uwe and Mikolajick, Thomas},
  year = 2012,
