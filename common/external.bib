@article{kozodaevMitigatingWakeupEffect2019,
  title = {Mitigating Wakeup Effect and Improving Endurance of Ferroelectric {{HfO2-ZrO2}} Thin Films by Careful {{La-doping}}},
  author = {Kozodaev, Maxim G. and Chernikova, Anna G. and Korostylev, Evgeny V. and Park, Min Hyuk and Khakimov, Roman R. and Hwang, Cheol S. and Markeev, Andrey M.},
  year = 2019,
