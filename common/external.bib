  title = {Synaptic Devices Based on Ferroelectric Hafnium Oxide: {{Recent}} Advances, Challenges, and Future Perspectives},
  shorttitle = {Synaptic Devices Based on Ferroelectric Hafnium Oxide},
  author = {Lederer, Maximilian and K{\"a}mpfe, Thomas},
