@article{richterSiDopedHafnium2017,
  title = {Si {{Doped Hafnium Oxide}}---{{A}} ``{{Fragile}}'' {{Ferroelectric System}}},
  author = {Richter, Claudia and Schenk, Tony and Park, Min Hyuk and Tscharntke, Franziska A. and Grimley, Everett D. and LeBeau, James M. and Zhou, Chuanzhen and Fancher, Chris M. and Jones, Jacob L. and Mikolajick, Thomas and Schroeder, Uwe},
