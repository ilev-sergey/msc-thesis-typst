  author = {Troyanchuk, I O and Bushinsky, M V and Tereshko, N V and Lanovsky, R A and Sikolenko, V V and Ritter, {\cyrchar\CYRS} and Orlov, Yu S and Ovchinnikov, S G},
  year = 2018,
