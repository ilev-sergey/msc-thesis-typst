@article{eid5GWirelessPower2021,
  title = {{{5G}} as a Wireless Power Grid},
  author = {Eid, Aline and Hester, Jimmy G. D. and Tentzeris, Manos M.},
  year = 2021,
  month = jan,
  journal = {Scientific Reports},
