@article{jiangAtomicInsightSuccessive2023,
  title = {Atomic {{Insight}} into the {{Successive Antiferroelectric}}--{{Ferroelectric Phase Transition}} in {{Antiferroelectric Oxides}}},
  author = {Jiang, Ru-Jian and Cao, Yi and Geng, Wan-Rong and Zhu, Mei-Xiong and Tang, Yun-Long and Zhu, Yin-Lian and Wang, Yujia and Gong, Fenghui and Liu, Su-Zhen and Chen, Yu-Ting and Liu, Jiaqi and Liu, Nan and Wang, Jing-Hui and Lv, Xiao-Dong and Chen, Shuang-Jie and Ma, Xiu-Liang},
  year = 2023,
