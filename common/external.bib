@article{chenElectronTrappingProcess1998,
  title = {Electron Trapping Process in Ferroelectric Lead--Zirconate--Titanate Thin-Film Capacitors},
  author = {Chen, Hong-ming and Lee, Joseph Ya-min},
  year = 1998,
  month = jul,
  journal = {Applied Physics Letters},
  volume = {73},
  number = {3},
  pages = {309--311},
  issn = {0003-6951, 1077-3118},
  doi = {10.1063/1.121818},
  urldate = {2025-09-09},
  abstract = {The effects of constant voltage stress on ferroelectric lead--zirconate--titanate (PZT) thin-film capacitors have been studied. Two stress effects are observed in the PZT capacitance--voltage (C--V) characteristics. The first is that the capacitance is reduced, and the second is a voltage shift of the C--V curve. These effects are found to depend on the stress electric field and the injected charge fluence. A correlation between the stress effects and the electron trapping inside the films is established. The injected charge fluence can be calculated from the leakage current. The trapping efficiency, electron capture cross section, and the trap density are obtained from the measured injected charge influence and the C--V voltage shift. The calculated value of the electron capture cross-section {$\sigma$}T is 1.89\texttimes 10-19\,cm2 and the neutral electron trap density NT is 1.20\texttimes 1013\,cm-2.},
  langid = {english},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\CHEN\Chen and Lee - 1998 - Electron trapping process in ferroelectric lead–zirconate–titanate thin-film capacitors.pdf}
}

@article{chengReversibleTransitionPolar2022,
  title = {Reversible Transition between the Polar and Antipolar Phases and Its Implications for Wake-up and Fatigue in {{HfO2-based}} Ferroelectric Thin Film},
  author = {Cheng, Yan and Gao, Zhaomeng and Ye, Kun Hee and Park, Hyeon Woo and Zheng, Yonghui and Zheng, Yunzhe and Gao, Jianfeng and Park, Min Hyuk and Choi, Jung-Hae and Xue, Kan-Hao and Hwang, Cheol Seong and Lyu, Hangbing},
