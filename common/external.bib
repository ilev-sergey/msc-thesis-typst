@article{mehmoodBulkDepolarizationFields2019,
  title = {Bulk {{Depolarization Fields}} as a {{Major Contributor}} to the {{Ferroelectric Reliability Performance}} in {{Lanthanum Doped Hf}} {\textsubscript{0.5}} {{Zr}} {\textsubscript{0.5}} {{O}} {\textsubscript{2}} {{Capacitors}}},
  author = {Mehmood, Furqan and Hoffmann, Michael and Lomenzo, Patrick D. and Richter, Claudia and Materano, Monica and Mikolajick, Thomas and Schroeder, Uwe},
  year = 2019,
  month = nov,
  journal = {Advanced Materials Interfaces},
  volume = {6},
  number = {21},
  pages = {1901180},
  issn = {2196-7350, 2196-7350},
  doi = {10.1002/admi.201901180},
  urldate = {2024-02-27},
  abstract = {Abstract                            After the discovery of ferroelectricity in HfO               2               , many dopants have been incorporated into the material to improve the ferroelectric properties. The binary mixture of HfO               2               and ZrO               2               , Hf                                x                              Zr                                x                              -1               O               2               , showed the widest process window in terms of polarization, but other memory related aspects still need improvement. Recently, the co-doping of La into a mixed Hf               0.5               Zr               0.5               O               2               , La:HZO, was reported to improve the endurance properties further but the explanation spanning both structural and electrical characteristics of La:HZO and their interaction is still missing. In this work, an extensive study of La:HZO with La content ranging from 0 to 4.3 mol\% is conducted and resultant stabilization of nonpolar tetragonal phase, coercive field reduction, endurance improvement, stronger retention loss, and less imprinted hysteresis loop is reported with increasing La concentration. The model simultaneously explaining the electrical and structural properties is presented. In ferroelectric capacitor structures, the depolarization fields originating from nonferroelectric layers at the metal/ferroelectric interface are discussed extensively in previous studies but, here, for the first time, the impact of depolarization fields from nonferroelectric regions in the bulk of the ferroelectric material is reported, which is an important element to explain all the observed trends.},
  langid = {english},
  keywords = {unread,wake-up},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\mehmood\Mehmood et al. - 2019 - Bulk Depolarization Fields as a Major Contributor to the Ferroelectric Reliability Performance in La.pdf}
}

@article{mehmoodWakeUpMechanismsFerroelectric2020,
  title = {Wake-{{Up Mechanisms}} in {{Ferroelectric Lanthanum}}-{{Doped Hf}} {\textsubscript{0.5}} {{Zr}} {\textsubscript{0.5}} {{O}} {\textsubscript{2}} {{Thin Films}}},
  author = {Mehmood, Furqan and Mikolajick, Thomas and Schroeder, Uwe},
