@article{liaoHfO2basedFerroelectricThin2023,
  title = {{{HfO2-based}} Ferroelectric Thin Film and Memory Device Applications in the Post-{{Moore}} Era: {{A}} Review},
  shorttitle = {{{HfO2-based}} Ferroelectric Thin Film and Memory Device Applications in the Post-{{Moore}} Era},
