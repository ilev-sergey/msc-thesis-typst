  urldate = {2025-09-04},
  abstract = {The experimental characteristics of polarization fatigue in thin-film, bulk ceramic, and single-crystalline ferroelectrics have been reviewed in detail. Various scenarios and models proposed for fatigue in ferroelectric materials during the past few decades have been discussed, together with our own model developed very recently [Phys. Rev. Lett.\hphantom{,}97, 177601 (2006); Phys. Rev. B\hphantom{,}75, 244104 (2007)]. Interpretations for the experimental data reviewed in this paper but untreated in our previous work [Phys. Rev. B\hphantom{,}75, 244104 (2007)] as well as the methods of improving the fatigue endurance in ferroelectrics are given based on this model. Finally, the results on polarization fatigue in some special classes of ferroelectrics such as multiferroics (e.g., BiFeO3-based materials), ferroelectric polymers, and antiferroelectric thin films and ceramics are discussed and accounted for in light of our model.},
