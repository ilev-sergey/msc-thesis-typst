@article{liuOrientationIndependentGrowth2022,
  title = {Orientation {{Independent Growth}} of {{Uniform Ferroelectric Hf0}}.{{5Zr0}}.{{5O2 Thin Films}} on {{Silicon}} for {{High-Density 3D Memory Applications}}},
  author = {Liu, Chen and Yang, Qijun and Zeng, Binjian and Jiang, Yongquan and Zheng, Shuaizhi and Liao, Jiajia and Dai, Siwei and Zhong, Xiangli and Zhou, Yichun and Liao, Min},
  year = 2022,
  journal = {Advanced Functional Materials},
  volume = {32},
  number = {49},
  pages = {2209604},
  issn = {1616-3028},
  doi = {10.1002/adfm.202209604},
  urldate = {2024-09-02},
  abstract = {The highly scalable ferroelectric hafnia-based thin films can be easily integrated into ferroelectric field-effect transistors (FeFETs) by existing Si technology, which are regarded as one of the promising candidates for fast read/write, energy-efficient, and high-density nonvolatile memories. However, device-to-device variation in threshold voltage (VTH) caused by non-uniformity of ferroelectric properties is a serious challenge for implementing hafnia-based FeFETs in high-density nonvolatile memories. Here, the substrate-orientation independent growth of Hf0.5Zr0.5O2 (HZO) thin films is realized with uniform ferroelectricity by using HfO2 seed layers. The HfO2 seed layers are beneficial to improving the ferroelectric polarization of HZO thin films grown on differently oriented Si substrates and reducing the variation in ferroelectric properties. Moreover, device simulation confirms that the proposed scheme contributes to realizing uniform memory properties in 3D vertical HZO-based FeFETs. This study suggests the possibility to implement hafnia-based FeFETs into 3D vertical high-density memory.},
  langid = {english}
}

@misc{liuPreciseControlCharge2024,
  title = {Precise {{Control}} of {{Charge Injection}}, {{Fatigue}}, {{Wake-Up}} and {{Break-Down}} in {{Hf}}{$_0$}.{$_{5}$}{{Zr}}{$_0$}.{$_{5}$}{{O}}{$_2$}-{{Based Ferroelectric Memories}}},
  author = {Liu, Nannan and Luo, Chunlai and Wu, Hongdi and Ding, Yecheng and Lu, Xubing and Yan, Zhibo and Liu, Jun-Ming and Yuan, Guoliang},
  year = 2024,
  publisher = {SSRN},
  doi = {10.2139/ssrn.4692701},
  urldate = {2025-09-10},
  abstract = {Hf0.5Zr0.5O2 (HZO) thin films are promising to be applied to ferroelectric memories. However, these materials often face challenges such as polarization fluctuations (e.g., fatigue and wake-up) and electric break-down incidents during the "1/0" write/read cycles, hindering their industrial application. Herein, fatigue, wake-up and electric break-down seriously depend on injected charges, which can be well controlled by the electric field for polarization switching (Es). Once the injected charges to HZO film are basically equal to the charges leaving from HZO film at a suitable Es being close to 1.5 times of coercive field (Ec), the accumulation of charges inside interior HZO film increases rather slowly with cycles increasing, and the HZO film presents excellent polarization stability. On the contrary, the serious charge accumulation in HZO film introduces a strong fatigue at Es \textasciitilde{} 1.2Ec and induces strong wake-up effect and then electric break-down at Es \textasciitilde{} 2Ec. Furthermore, it is found that the leakage current and dielectric permittivity ({$\varepsilon$}r) can effectively monitor the charge accumulation and provide an early warning for fatigue and electric break-down. Overall, this work proves that charge accumulation influences fatigue, wake-up or break-down effects, and demonstrates Es as an effective tool to restrain charge accumulation in ferroelectric memory.},
  archiveprefix = {SSRN},
  langid = {english},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\LIU\Liu et al. - 2024 - Precise Control of Charge Injection, Fatigue, Wake-Up and Break-Down in Hf₀.₅Zr₀.₅O₂-Based Ferroelec.pdf}
}

@article{liuReversibleFatiguerejuvenationProcedure2023,
  title = {Reversible Fatigue-Rejuvenation Procedure and Its Mechanism in {{Hf}}{\textsubscript{0.5}} {{Zr}}{\textsubscript{0.5}} {{O}}{\textsubscript{2}} Epitaxial Films},
  author = {Liu, Zhuohui and Zhong, Hai and Xie, Donggang and He, Meng and Wang, Can and Lyu, Hangbing and Yang, Guozhen and Jin, Kuijuan and Ge, Chen},
