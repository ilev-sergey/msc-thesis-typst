@article{jaszewskiPhaseTransformationsDriving2024,
  title = {Phase {{Transformations Driving Biaxial Stress Reduction During Wake}}-{{Up}} of {{Ferroelectric Hafnium Zirconium Oxide Thin Films}}},
  author = {Jaszewski, Samantha T. and Fields, Shelby S. and Calderon, Sebastian and Aronson, Benjamin L. and Beechem, Thomas E. and Kelley, Kyle P. and Zhang, Casey and Lenox, Megan K. and Brummel, Ian A. and Dickey, Elizabeth C. and Ihlefeld, Jon F.},
  year = 2024,
  month = nov,
  journal = {Advanced Electronic Materials},
  volume = {10},
  number = {11},
  pages = {2400151},
  issn = {2199-160X, 2199-160X},
  doi = {10.1002/aelm.202400151},
  urldate = {2025-11-26},
  abstract = {Abstract                            Biaxial stress is identified to play an important role in the polar orthorhombic phase stability in hafnium oxide-based ferroelectric thin films. However, the stress state during various stages of wake-up has not yet been quantified. In this work, the stress evolution with field cycling in hafnium zirconium oxide capacitors is evaluated. The remanent polarization of a 20~nm thick hafnium zirconium oxide thin film increases from 9.80 to 15.0~\textmu C~cm               -2               following 10               6               field cycles. This increase in remanent polarization is accompanied by a decrease in relative permittivity that indicates that a phase transformation has occurred. The presence of a phase transformation is supported by nano-Fourier transform infrared spectroscopy measurements and scanning transmission electron microscopy that show an increase in ferroelectric phase content following wake-up. The stress of individual devices field cycled between pristine and 10               6               cycles is quantified using the sin               2               (               {$\psi$}               ) technique, and the biaxial stress is observed to decrease from 4.3 \textpm{} 0.2 to 3.2 \textpm{} 0.3~GPa. The decrease in stress is attributed, in part, to a phase transformation from the antipolar               Pbca               phase to the ferroelectric               Pca               2               1               phase. This work provides new insight into the mechanisms controlling and/or accompanying polarization wake-up in hafnium oxide-based ferroelectrics.},
  langid = {english},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\JASZEWSKI\Jaszewski et al. - 2024 - Phase Transformations Driving Biaxial Stress Reduction During Wake‐Up of Ferroelectric Hafnium Zirco.pdf}
}

