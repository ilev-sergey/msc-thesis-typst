@article{shiraishiImpactMechanicalStress2016,
  title = {Impact of Mechanical Stress on Ferroelectricity in ({{Hf0}}.{{5Zr0}}.5){{O2}} Thin Films},
  author = {Shiraishi, Takahisa and Katayama, Kiliha and Yokouchi, Tatsuhiko and Shimizu, Takao and Oikawa, Takahiro and Sakata, Osami and Uchida, Hiroshi and Imai, Yasuhiko and Kiguchi, Takanori and Konno, Toyohiko J. and Funakubo, Hiroshi},
