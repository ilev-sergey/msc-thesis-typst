  volume = {6},
  number = {21},
  pages = {530--534},
  issn = {2059-8521},
  doi = {10.1557/s43580-021-00105-1},
  urldate = {2024-06-16},
  abstract = {In this article, we investigate the capacitance--voltage (C--V) characteristics of HfxZr1-xO2 metal-ferroelectric-metal (MFM) thin-film capacitors with various Zr doping for varactor applications. The impact of field cycling during the wake-up process on the capacitance was analyzed. In addition, the effect of antiferroelectric-like (AFE) behavior on tuning was investigated. The transition between ferroelectric (FE) and AFE regime is particularly interesting for varactor application, as a reduced bias is required for tuning. The cycle dependence of the FE and AFE properties at elevated temperatures was also investigated, where it was shown that with an increase of temperature, the tunability is reduced. Temperature measurements also comply with recent studies of ferroelastic nature of AFE behavior.},
  langid = {english},
  keywords = {antiferroelectrics,FE/AFE transition},
  file = {C:\Users\Sergey\OneDrive\zotero-library\AUTH\abdulazhanov\Abdulazhanov et al. - 2021 - Influence of antiferroelectric-like behavior on tuning properties of ferroelectric HZO-based varacto.pdf}
